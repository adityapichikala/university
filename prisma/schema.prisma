// University ERP — Prisma Schema (PostgreSQL via Supabase)
//
// Multi-tenant: every tenant-owned model carries collegeId + @@index([collegeId]).
// Option A from the architecture doc (§4.2): single college today, columns in
// place so full multi-tenancy is a query-scope change, not a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── String conventions (SQLite has no enums — keep these in sync with lib/roles.ts) ───
// Role:          STUDENT, TEACHER, HOD, ADMIN, REGISTRAR, FINANCE, LIBRARIAN,
//                WARDEN, HR, PLACEMENT, PARENT
// UserStatus:    ACTIVE, INACTIVE
// AdmissionStatus: PENDING, APPROVED, REJECTED, WAITLISTED
// AttendanceStatus: PRESENT, ABSENT, LATE
// SubmissionStatus: SUBMITTED, LATE, RESUBMITTED
// FeePaymentStatus: PENDING, PAID, OVERDUE, WAIVED
// LeaveStatus:   PENDING, APPROVED, REJECTED
// PlacementApplicationStatus: APPLIED, SHORTLISTED, INTERVIEWED, OFFERED, REJECTED
// ExamType:      MIDTERM, FINAL, QUIZ
// CertificateType: BONAFIDE, TRANSCRIPT, NO_DUES
// AgentActionStatus: PENDING, APPROVED, REJECTED, EXECUTED

// ─── Core institutional models ───────────────────────────────────────────────

model College {
  id        String   @id @default(cuid())
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments           Department[]
  users                 User[]
  classes               Class[]
  courses               Course[]
  enrollments           CourseEnrollment[]
  sectionAccess         CourseSectionAccess[]
  admissions            Admission[]
  timetableSlots        TimetableSlot[]
  attendances           Attendance[]
  assignments           Assignment[]
  submissions           Submission[]
  grades                Grade[]
  exams                 Exam[]
  examResults           ExamResult[]
  calendarDays          AcademicCalendarDay[]
  feeStructures         FeeStructure[]
  feeRecords            FeeRecord[]
  feePayments           FeePayment[]
  libraryItems          LibraryItem[]
  libraryIssues         LibraryIssue[]
  hostelRooms           HostelRoom[]
  hostelAllocations     HostelAllocation[]
  hostelLeaves          HostelLeave[]
  semesters             Semester[]
  employees             Employee[]
  leaveRequests         LeaveRequest[]
  placementDrives       PlacementDrive[]
  placementApplications PlacementApplication[]
  notifications         Notification[]
  certificates          Certificate[]
  parentLinks           ParentChild[]
  agentActionLogs       AgentActionLog[]
  clearances            Clearance[]
}

model Department {
  id        String   @id @default(cuid())
  name      String
  collegeId String
  hodUserId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college       College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  hod           User?          @relation("DepartmentHOD", fields: [hodUserId], references: [id])
  users         User[]         @relation("UserDepartment")
  courses       Course[]
  classes       Class[]
  employees     Employee[]
  notifications Notification[]

  @@index([collegeId])
}

model User {
  id           String    @id @default(cuid())
  regno        String    @unique
  name         String
  email        String    @unique
  passwordHash String
  role         String
  collegeId    String?
  departmentId String?
  status       String    @default("ACTIVE")
  /// A student's home section. Teachers see this when marking attendance, and
  /// it doubles as the scope for their roll number — roll numbers restart at 1
  /// in every section, so uniqueness is (classId, rollNo), never rollNo alone.
  classId      String?
  /// Roll number *within the section*. Null for staff, who have no roll call.
  rollNo       String?
  /// Password reset: a bcrypt hash of the 6-digit OTP, never the code itself.
  /// Null unless a reset is in flight; cleared the moment it is used.
  resetOtp     String?
  /// Absolute expiry for that OTP (10 minutes from issue). Checked before the
  /// hash comparison so a stale code is refused without doing the bcrypt work.
  otpExpiry    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  college         College?    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department      Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  class           Class?      @relation("UserClass", fields: [classId], references: [id], onDelete: SetNull)
  hodOfDepartment Department? @relation("DepartmentHOD")

  // Teaching
  coursesTaught Course[] @relation("CourseTeacher")

  // Student relations
  enrollments           CourseEnrollment[]
  attendanceRecords     Attendance[]
  submissions           Submission[]
  examResults           ExamResult[]
  feeRecords            FeeRecord[]
  feePaymentsReceived   FeePayment[]
  libraryIssues         LibraryIssue[]
  hostelAllocations     HostelAllocation[]
  hostelLeaves          HostelLeave[]
  clearances            Clearance[] @relation("ClearanceStudent")
  clearancesDecided     Clearance[] @relation("ClearanceDecidedBy")
  placementApplications PlacementApplication[]
  certificates          Certificate[]

  // Teacher / staff relations
  assignmentsCreated Assignment[]
  gradesGiven        Grade[]

  // Employee
  employee Employee?

  // Family: who this parent may view, and who may view this student
  children  ParentChild[] @relation("ParentLinks")
  guardians ParentChild[] @relation("ChildLinks")

  // Admin
  notificationsCreated Notification[]
  announcementTargets  NotificationTarget[]
  agentActionsApproved AgentActionLog[]
  admissionsConverted  Admission[]           @relation("AdmissionConvertedBy")
  hostelLeavesDecided  HostelLeave[]         @relation("HostelLeaveDecidedBy")
  calendarDaysCreated  AcademicCalendarDay[]

  // Tier-2 RBAC: per-user permission overrides
  permissionOverrides UserPermission[]

  /// Roll numbers are unique *within a section*, not across the college.
  /// SQLite permits many NULLs here, so staff (classId NULL) are unaffected.
  @@unique([classId, rollNo])
  @@index([collegeId])
  @@index([role])
  @@index([classId])
}

// ─── Tier 2 RBAC: Permission layer (architecture doc §4.1) ───────────────────

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "grade.entry", "lms.access"
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]
}

/// Default permissions granted to every user holding a given role.
/// UserPermission entries for the same key override these.
model RolePermission {
  role         String
  permissionId String
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([role])
}

/// Per-user grant/revoke. `granted = true` forces allow, `false` forces deny.
/// This is what powers the per-student feature toggles and the faculty matrix.
model UserPermission {
  userId       String
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
}

// ─── Academic models ────────────────────────────────────────────────────────

model Class {
  id           String   @id @default(cuid())
  name         String
  collegeId    String
  departmentId String
  semester     Int
  /// The semester record this section sits in. `semester` (the int) is kept for
  /// display and sorting; this is the link that makes filtering unambiguous.
  semesterId   String?
  batchYear    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  college        College               @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department     Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesterRecord Semester?             @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  enrollments    CourseEnrollment[]
  /// Students whose home section this is.
  students       User[]                @relation("UserClass")
  sectionAccess  CourseSectionAccess[]
  timetableSlots TimetableSlot[]
  notifications  Notification[]
  calendarDays   AcademicCalendarDay[]

  @@unique([collegeId, name])
  @@index([collegeId])
  @@index([departmentId])
  @@index([semesterId])
}

model Course {
  id           String   @id @default(cuid())
  name         String
  // NOT globally unique: two colleges may both run "CS101" (Option A tenancy §4.2).
  code         String
  collegeId    String
  departmentId String
  credits      Int      @default(3)
  teacherId    String?
  /// Seat cap for one section of this course (a section is a course + class
  /// pair). Checked inside the enrollment transaction, so two concurrent
  /// enrolments cannot both take the last seat. 0 means "no cap".
  capacity     Int      @default(60)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  college        College               @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department     Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teacher        User?                 @relation("CourseTeacher", fields: [teacherId], references: [id])
  enrollments    CourseEnrollment[]
  sectionAccess  CourseSectionAccess[]
  timetableSlots TimetableSlot[]
  attendances    Attendance[]
  assignments    Assignment[]
  exams          Exam[]

  @@unique([collegeId, code])
  @@index([collegeId])
  @@index([departmentId])
  @@index([teacherId])
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  collegeId String
  studentId String
  courseId  String
  classId   String
  /// CONFIRMED takes a seat and counts toward the credit cap and timetable
  /// clash checks. WAITLISTED does neither — it only holds a queue position
  /// until a seat frees up. SQLite has no enums, so lib/enrollment.ts owns
  /// the vocabulary (same arrangement as lib/roles.ts).
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  /// One row per student per course — a waitlist entry is the same row with
  /// status WAITLISTED, so a student can never hold both a seat and a place
  /// in the queue for the same course.
  @@unique([studentId, courseId])
  @@index([collegeId])
  @@index([status])
}

// Section-level access control (Tier 3, resource scoping).
// Which classes (sections) may access a given course. enabled = false locks
// that section out: their students stop seeing the course and cannot be marked.
model CourseSectionAccess {
  id        String   @id @default(cuid())
  collegeId String
  courseId  String
  classId   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([courseId, classId])
  @@index([collegeId])
}

// ─── Admissions ─────────────────────────────────────────────────────────────

model Admission {
  id                String   @id @default(cuid())
  collegeId         String
  applicantName     String
  email             String
  phone             String
  programAppliedFor String
  documentsUrl      String?
  status            String   @default("PENDING")
  meritScore        Float?
  convertedToUserId String?
  convertedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  college     College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  convertedBy User?   @relation("AdmissionConvertedBy", fields: [convertedByUserId], references: [id])

  @@index([collegeId])
  @@index([status])
}

// ─── Timetable ──────────────────────────────────────────────────────────────

model TimetableSlot {
  id        String   @id @default(cuid())
  collegeId String
  courseId  String
  classId   String
  dayOfWeek Int // 0=Sunday … 6=Saturday
  startTime String // "09:00"
  endTime   String // "10:00"
  room      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([classId])
}

// ─── Attendance ─────────────────────────────────────────────────────────────

model Attendance {
  id        String   @id @default(cuid())
  collegeId String
  studentId String
  courseId  String
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, date])
  @@index([collegeId])
  @@index([courseId, date])
}

// ─── Assignments & grading ──────────────────────────────────────────────────

model Assignment {
  id               String   @id @default(cuid())
  collegeId        String
  courseId         String
  teacherId        String
  title            String
  description      String
  dueDate          DateTime
  maxMarks         Float
  rubric           String?
  allowedFileTypes String // comma separated: "pdf,docx,zip"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  college     College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     User         @relation(fields: [teacherId], references: [id])
  submissions Submission[]

  @@index([collegeId])
  @@index([courseId])
}

model Submission {
  id           String   @id @default(cuid())
  collegeId    String
  assignmentId String
  studentId    String
  fileUrl      String
  submittedAt  DateTime @default(now())
  version      Int      @default(1)
  status       String   @default("SUBMITTED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  college    College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade      Grade?

  // One live submission per student per assignment. Re-submitting bumps
  // `version` on the same row rather than creating a second one, so a
  // submission always has exactly one Grade (Grade.submissionId is @unique).
  @@unique([assignmentId, studentId])
  @@index([collegeId])
  @@index([assignmentId])
  @@index([studentId])
}

model Grade {
  id               String   @id @default(cuid())
  collegeId        String
  submissionId     String   @unique
  score            Float
  feedback         String?
  gradedByUserId   String
  gradedAt         DateTime @default(now())
  aiSuggestedScore Float?
  history          String? // serialized JSON (re-grade trail)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  college    College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy   User       @relation(fields: [gradedByUserId], references: [id])

  @@index([collegeId])
}

// ─── Examinations & results ─────────────────────────────────────────────────

/// A semester is a real record with its own id, not a bare integer.
///
/// Results are filtered by semester id rather than by number, so renaming or
/// renumbering a semester never orphans a student's history.
/// Hostel leave — a student asking to be away from their room overnight.
///
/// Deliberately separate from `LeaveRequest`, which is staff leave tied to an
/// Employee record. A student has no Employee row, and the two flows have
/// different approvers (warden vs HOD/HR).
model HostelLeave {
  id              String    @id @default(cuid())
  collegeId       String
  studentId       String
  fromDate        DateTime
  toDate          DateTime
  reason          String
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status          String    @default("PENDING")
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student   User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("HostelLeaveDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([studentId])
  @@index([status])
}

model Semester {
  id        String    @id @default(cuid())
  collegeId String
  /// 1-based position in the programme (1, 2, 3 …).
  number    Int
  /// Display name, e.g. "Semester 3".
  name      String
  /// The semester currently running — drives the default filter on results.
  isCurrent Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  classes Class[]
  exams   Exam[]

  @@unique([collegeId, number])
  @@index([collegeId])
}

model Exam {
  id         String   @id @default(cuid())
  collegeId  String
  courseId   String
  examDate   DateTime
  examType   String
  maxMarks   Float
  /// Which semester this exam belongs to; results are grouped by it.
  semesterId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  college  College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester Semester?    @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  results  ExamResult[]

  @@index([collegeId])
  @@index([courseId])
  @@index([semesterId])
  @@index([examDate])
}

/// Non-teaching days: public holidays, institute closures, exam weeks declared
/// as no-class days. A separate table rather than a flag on TimetableSlot
/// because a holiday cancels *every* slot on a date — including ones added
/// after the holiday was declared.
model AcademicCalendarDay {
  id              String   @id @default(cuid())
  collegeId       String
  /// The whole day this entry covers, stored at UTC midnight. Date-only on
  /// purpose: a holiday is not an instant.
  date            DateTime
  title           String
  /// HOLIDAY | CLOSURE | BREAK | EVENT — SQLite has no enum, so
  /// lib/calendar.ts is the source of truth (CALENDAR_DAY_KINDS).
  kind            String   @default("HOLIDAY")
  /// Null = the whole college. Set = only this section is affected.
  classId         String?
  createdByUserId String
  createdAt       DateTime @default(now())

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  class     Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdByUserId], references: [id])

  @@unique([collegeId, date, classId])
  @@index([collegeId, date])
  @@index([classId])
}

model ExamResult {
  id            String    @id @default(cuid())
  collegeId     String
  examId        String
  studentId     String
  marksObtained Float
  grade         String
  publishedAt   DateTime? // null = not yet visible to students
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([collegeId])
}

// ─── Fees & finance ─────────────────────────────────────────────────────────

model FeeStructure {
  id          String   @id @default(cuid())
  collegeId   String
  programName String
  batchYear   Int
  amount      Float
  dueDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college    College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  feeRecords FeeRecord[]

  @@index([collegeId])
}

model FeeRecord {
  id             String    @id @default(cuid())
  collegeId      String
  studentId      String
  feeStructureId String
  amountPaid     Float     @default(0)
  paymentDate    DateTime?
  status         String    @default("PENDING")
  transactionRef String?
  waiverReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  college      College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     FeePayment[]

  @@unique([studentId, feeStructureId])
  @@index([collegeId])
}

// An installment. FeeRecord.amountPaid is the cached sum of these — the same
// pattern as LibraryItem.availableCopies: derive the truth, cache the total.
model FeePayment {
  id             String   @id @default(cuid())
  collegeId      String
  feeRecordId    String
  amount         Float
  paidAt         DateTime @default(now())
  transactionRef String?
  method         String   @default("CASH")
  receivedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  college    College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  feeRecord  FeeRecord @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)
  receivedBy User?     @relation(fields: [receivedById], references: [id])

  @@index([collegeId])
  @@index([feeRecordId])
}

// ─── Library ────────────────────────────────────────────────────────────────

model LibraryItem {
  id              String   @id @default(cuid())
  collegeId       String
  title           String
  author          String
  isbn            String?  @unique
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  college College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  issues  LibraryIssue[]

  @@index([collegeId])
}

model LibraryIssue {
  id         String    @id @default(cuid())
  collegeId  String
  itemId     String
  studentId  String
  issuedAt   DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  fineAmount Float     @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  college College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  item    LibraryItem @relation(fields: [itemId], references: [id])
  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([studentId])
}

// ─── Hostel ─────────────────────────────────────────────────────────────────

model HostelRoom {
  id         String   @id @default(cuid())
  collegeId  String
  block      String
  roomNumber String
  capacity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  college     College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  allocations HostelAllocation[]

  @@unique([collegeId, block, roomNumber])
  @@index([collegeId])
}

model HostelAllocation {
  id          String    @id @default(cuid())
  collegeId   String
  studentId   String
  roomId      String
  allocatedAt DateTime  @default(now())
  vacatedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  college College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room    HostelRoom @relation(fields: [roomId], references: [id])

  @@index([collegeId])
  @@index([roomId])
}

// ─── HR & payroll ───────────────────────────────────────────────────────────

model Employee {
  id           String   @id @default(cuid())
  collegeId    String
  userId       String   @unique
  designation  String
  departmentId String
  salaryBand   String
  joinedAt     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  college       College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department     @relation(fields: [departmentId], references: [id])
  leaveRequests LeaveRequest[]

  @@index([collegeId])
  @@index([departmentId])
}

model LeaveRequest {
  id         String    @id @default(cuid())
  collegeId  String
  employeeId String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String    @default("PENDING")
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  college  College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

// ─── Placement ──────────────────────────────────────────────────────────────

model PlacementDrive {
  id                  String   @id @default(cuid())
  collegeId           String
  companyName         String
  role                String
  eligibilityCriteria String
  driveDate           DateTime
  packageOffered      String
  /// The job description, as text. Stored rather than linked: there is no file
  /// store in this deployment, and a JD that 404s is worse than none. The
  /// download endpoint renders it as a PDF (lib/export-utils.ts).
  jobDescription      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  college      College                @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  applications PlacementApplication[]

  @@index([collegeId])
  @@index([driveDate])
}

model PlacementApplication {
  id             String    @id @default(cuid())
  collegeId      String
  driveId        String
  studentId      String
  status         String    @default("APPLIED")
  /// Why the student withdrew. Asked for at withdrawal time: a reason captured
  /// in the moment is worth more to the placement cell than a guess later, and
  /// it is what turns "attrition" into something actionable.
  withdrawReason String?
  withdrawnAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  college College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  drive   PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student User           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([driveId, studentId])
  @@index([collegeId])
  @@index([status])
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id                 String    @id @default(cuid())
  collegeId          String?
  title              String
  body               String
  // LOW | NORMAL | URGENT — SQLite has no enum, so lib/announcements.ts is the
  // source of truth (ANNOUNCEMENT_PRIORITIES / isAnnouncementPriority).
  priority           String    @default("NORMAL")
  // After this instant the notice is no longer served to anyone. Null = never
  // expires. Expiry is checked on read, so a notice that lapses while a tab is
  // open disappears on the next fetch rather than needing a cron job.
  expiresAt          DateTime?
  targetRole         String? // null = all roles
  targetDepartmentId String?
  targetClassId      String?
  createdByUserId    String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  college          College?             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdBy        User                 @relation(fields: [createdByUserId], references: [id])
  targetDepartment Department?          @relation(fields: [targetDepartmentId], references: [id])
  targetClass      Class?               @relation(fields: [targetClassId], references: [id])
  reads            NotificationRead[]
  targets          NotificationTarget[]

  @@index([collegeId])
  @@index([targetRole])
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

// Role / department / class targeting is a *predicate* — it matches whoever
// fits today. Naming an individual is a *fact*. This join stores the fact, so
// an announcement can reach one specific person without inventing a role for
// them, and the audience survives later changes to their role or section.
model NotificationTarget {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  createdAt      DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

// ─── Family links (parent portal) ───────────────────────────────────────────
// A parent is a real User, but "which child is yours" is a fact, not a role.
// Modelling it as a join — rather than matching surnames or stuffing an id on
// User — means two parents can both see one student, and one parent can see
// two children, without inventing a role for either case.
model ParentChild {
  id        String   @id @default(cuid())
  collegeId String
  parentId  String
  studentId String
  relation  String   @default("GUARDIAN")
  createdAt DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  parent  User    @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student User    @relation("ChildLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

// ─── No-Dues clearance (graduating students) ─────────────────────────────────
//
// Four departments sign off a student before they graduate: LIBRARY, HOSTEL,
// FINANCE, ACADEMICS. The *effective* status is auto-derived from the
// operational tables (open fee records, un-returned books, outstanding
// backlogs, an un-vacated room) unless a department head has recorded a manual
// decision that overrides it. One row per (student, department); `manualStatus`
// null means "trust the auto check".

model Clearance {
  id              String    @id @default(cuid())
  collegeId       String
  studentId       String
  /// LIBRARY | HOSTEL | FINANCE | ACADEMICS — kept in sync with lib/clearance.ts.
  department      String
  /// Manual decision: 'CLEARED' or 'PENDING'. Null = fall back to the auto status.
  manualStatus    String?
  /// Who recorded the manual decision. Null once a row is cleared back to auto.
  decidedByUserId String?
  decidedAt       DateTime?
  /// Free-text reason, shown to the student. Optional.
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student   User    @relation("ClearanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("ClearanceDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  /// A student can hold exactly one decision per department.
  @@unique([studentId, department])
  @@index([collegeId])
  @@index([department])
}

// ─── Certificates ───────────────────────────────────────────────────────────

model Certificate {
  id        String   @id @default(cuid())
  collegeId String
  studentId String
  type      String
  issuedAt  DateTime @default(now())
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([studentId])
}

// ─── Agent audit log (architecture doc §4.3) ────────────────────────────────

model AgentActionLog {
  id               String   @id @default(cuid())
  collegeId        String?
  agentName        String
  actionType       String
  targetEntity     String
  status           String   @default("PENDING")
  approvedByUserId String?
  details          String // serialized JSON: { before, after, ip, … }
  // Tamper-evident chain: hash = sha256(prevHash + canonical(row)).
  // The governance banner shows the head of this chain.
  hash             String?
  prevHash         String?
  timestamp        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  college    College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  /// Restrict, not the implicit SetNull: approvedByUserId is one of the fields
  /// the row's hash is computed over, so nulling it on user deletion rewrote
  /// history and made the whole chain read as tampered with. An audit log has
  /// to be immutable — deactivate an account (User.status), never remove it.
  approvedBy User?    @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([collegeId])
  @@index([timestamp])
}
